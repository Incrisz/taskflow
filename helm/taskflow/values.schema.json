{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "api",
    "frontend",
    "postgres",
    "redis",
    "existingSecret",
    "config",
    "imagePullPolicy"
  ],
  "properties": {
    "api": {
      "type": "object",
      "required": [
        "image",
        "replicas"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": [
        "image",
        "replicas"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": [
        "image",
        "storage"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "redis": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "required": [
        "databaseName"
      ],
      "properties": {
        "databaseName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    }
  }
}
